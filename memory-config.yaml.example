server:
  host: "0.0.0.0"
  port: 9100

redis:
  url: "redis://localhost:6379"
  db: 0
  session_ttl: 86400  # 24 hours in seconds

topic_detection:
  llm:
    base_url: "https://api.openai.com/v1"
    api_key: ""  # or set MEMORY_LLM_API_KEY env var
    model: "gpt-4.1-nano"
    temperature: 0.0
    max_tokens: 50
  max_history_messages: 5
  fail_open: true

retrieval:
  max_messages: 50
