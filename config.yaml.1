# SGR Agent Core - Tool Calling Agent with Context Forge MCP Server
# Deployed on mcp-network

llm:
  api_key: "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"
  base_url: "https://api.openai.com/v1"
  model: "gpt-4o-mini"
  max_tokens: 8000
  temperature: 0.4

execution:
  max_clarifications: 3
  max_iterations: 10
  mcp_context_limit: 15000
  logs_dir: "logs"
  reports_dir: "reports"
  
mcp_server:
   enabled: true           # Enable/disable the MCP server (default: false)
   host: "0.0.0.0"         # Host to bind (default: "0.0.0.0")
   port: 8011              # Port to listen on (default: 8011)
   transport: "sse"        # Transport protocol (default: "sse")
   default_agent: null     # Agent to use (null = first available)
   tool_name: "time_agent"
   tool_description: "Use the tool to ask questions about time"
   
# Memory Configuration (topic-aware conversational memory)
memory:
   enabled: true                         # Enable/disable memory layer (default: false)
   #service_url: "http://host.docker.internal:9100"   # Memory microservice URL
   #timeout: 30                           # Request timeout in seconds (default: 0.3)
   #max_messages: 50                       # Max messages returned per topic (default: 50)
   rolling_summary:
     enabled: true                       # Enable/disable rolling summary (default: false)
     max_tokens_to_summarize: 2000        # Token budget for the rolling window (100-32000)
     summarization_model: null            # Model for summarization (null = agent's main model)
     summarization_timeout_s: 10.0        # Hard timeout for summarizer call (0.01-120.0)
     parallel_with_first_iteration: true  # Run in parallel with reasoning loop (default: true)
   
observability:
   mcp_field_mapping:
    user_id: "userId"
    #trace_id: "traceId"
    tags_fields:
        - "traceId"
   enabled: true                         # Enable tracing (default: false)
   provider: "langfuse"                  # Provider: "langfuse" or "noop"
   langfuse:
     public_key: "pk-lf-d62b29fd-99a9-47e2-9d65-d239c2bf8ec9"             # Or set LANGFUSE_PUBLIC_KEY env var
     secret_key: "sk-lf-9bb7fb0a-15bd-4acf-907b-f2f094d38445"             # Or set LANGFUSE_SECRET_KEY env var
     base_url: "http://host.docker.internal:3000"   # Or set LANGFUSE_BASE_URL env var
     environment: "development"          # Environment tag for trace segmentation
     flush_at: 512                       # Events per batch before auto-flush
     flush_interval: 5.0                 # Seconds between flushes
     sample_rate: 1.0                    # Trace sampling rate (0.0-1.0)
     debug: true                        # Enable SDK debug logging
   metrics_processors:                   # Custom metrics attached to traces
     - class: "TokenEfficiencyProcessor" # Tracks total tokens and efficiency ratio
       config: {}
     - class: "ToolUsageProcessor"       # Tracks unique tools and total tool calls
       config: {}

# MCP Client: Connect to Context Forge virtual server via SSE
# Uses host.docker.internal to reach the host-exposed port from inside Docker
mcp:
  mcpServers:
    context_forge:
      url: "http://host.docker.internal:4444/servers/93de07ef89df491fa3f1744a99f366ee/sse"
      headers:
        Authorization: "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..eP7Z5AWKDQzhVbpT5vWTLsopj2ZmryPd2SPuvK0zDDA"
